{
  "name": "truckflow-ops",
  "version": "1.0.0",
  "private": true,
  "description": "TruckFlow Ops — food truck operations platform. Current tenant: Birria Fusion.",
  "main": "server/index.js",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm run dev --prefix client -- --host 0.0.0.0",
    "build": "npm run build --prefix client",
    "start": "NODE_ENV=production node server/index.js",
    "db:init": "node server/db/init.js",
    "db:seed": "node server/db/seed.js",
    "setup": "npm run install:all && npm run db:init && npm run db:seed && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  }
}